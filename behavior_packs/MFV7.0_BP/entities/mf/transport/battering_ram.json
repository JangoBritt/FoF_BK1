{
	"format_version": "1.21.60",
	"minecraft:entity": {
		"description": {
			"identifier": "medieval:battering_ram_entity",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"properties": {
				"mf:health": {
					"type": "int",
					"range": [ 0 , 5 ],
					"client_sync": true,
					"default": 5
				}
			}
		},
		"component_groups": {
			"medieval:despawn": {
				"minecraft:instant_despawn": {}
			}
		},
		"components": {
			"minecraft:leashable": {
				"can_be_stolen": false,
				"hard_distance": 6,
				"max_distance": 10,
				"soft_distance": 4
			},
			"minecraft:collision_box": {
				"width": 2.9,
				"height": 4
			},
			"minecraft:custom_hit_test": {
				"hitboxes": [
					{
						"width": 3.05,
						"height": 4,
						"pivot": [0, 2, 0]
					}
				]
			},
			"minecraft:health": {
				"value": 1,
				"max": 1,
				"min": 1
			},
			"minecraft:timer": {
				"time": 0.5,
				"looping": true,
				"time_down_event": {
					"filters": {
						"all_of": [
							{ "test": "int_property", "domain": "mf:health", "operator": "<", "subject": "self", "value": 5  }
						]
					},
					"event": "mf:recover_health"
				}
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"deals_damage": "no",
						"cause": "entity_attack",
						"on_damage": {
							"filters": {
								"all_of": [
									{
										"test": "is_family",
										"subject": "other",
										"value": "player"
									}
								]
							},
							"target": "self",
							"event": "mf:reduce_health"
						}
					},
					{
						"cause": "projectile",
						"deals_damage": "no"
					},
					{
						"deals_damage": "no"
					}
				]
			},
			"minecraft:knockback_resistance": {
				"value": 100,
				"max": 100
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": true
			},
			"minecraft:nameable": {
				"allow_name_tag_renaming": false,
				"always_show": false
			},
			"minecraft:physics": {},
			"minecraft:is_chested": {},
			"minecraft:renders_when_invisible": {},
			"minecraft:conditional_bandwidth_optimization": {}
		},
		"events": {
			"mf:recover_health": {
				"set_property": { "mf:health": "q.property('mf:health') + 1" }
			},
			"mf:reduce_health": {
				"sequence": [
					{
						"filters": {
							"all_of": [
								{ "test": "int_property", "domain": "mf:health", "operator": "equals", "subject": "self", "value": 0  }
							]
						},
						"queue_command": { "command": [
							"playsound mob.zombie.woodbreak @a ~~~ 0.5 1.5",
							"loot spawn ~~~ loot \"mf/t/battering_ram\"",
							"event entity @s mf:despawn"
						] }
					},
					{
						"filters": {
							"all_of": [
								{ "test": "int_property", "domain": "mf:health", "operator": ">", "subject": "self", "value": 0  }
							]
						},
						"set_property": { "mf:health": "q.property('mf:health') - 1" },
						"queue_command": { "command": [ "playsound mob.zombie.wood @a ~~~ 0.5 1.5" ] }
					}
				]
			},
			"mf:despawn": { "add": { "component_groups": [ "medieval:despawn" ] } }
		}
	}
}