				"has_collision": false,
				"has_gravity": false
			},
			"minecraft:damage_sensor": { "triggers": [
				{
					"cause": "all",
					"deals_damage": "no"
				}
			] },
			"minecraft:health": {
				"min": 1,
				"value": 1,
				"max": 1
			},
			"minecraft:inventory": {
				"container_type": "inventory",
				"can_be_siphoned_from": true,
				"inventory_size": 27
			},
			"minecraft:nameable": {
				"always_show": false,
				"allow_name_tag_renaming": false
			},
			"minecraft:inside_block_notifier": {
