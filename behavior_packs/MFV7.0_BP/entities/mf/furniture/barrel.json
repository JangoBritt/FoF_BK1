{
	"format_version": "1.21.60",
	"minecraft:entity": {
		"description": {
			"identifier": "medieval:barrel_cont",
			"is_summonable": true,
			"is_spawnable": false,
			"is_experimental": false,
			"properties": {
				"mf:item": {
					"type": "int",
					"client_sync": true,
					"default": 0,
					"range": [ 0, 17 ]
				}
			}
		},
		"component_groups": {
			"mf:despawn": { "minecraft:instant_despawn": {} }
		},
		"components": {
			"minecraft:collision_box": {
				"width": 0,
				"height": 0
			},
			"minecraft:type_family": { "family": [ "inanimate", "medieval_container", "medieval_return_inv" ] },
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:custom_hit_test": { "hitboxes": [
