					{ "block": { "name": "minecraft:air" }, "entered_block_event": { "event": "mf:despawn", "target": "self" } }
				]
			},
			"minecraft:knockback_resistance": {
				"value": 100,
				"max": 100
			},
			"minecraft:persistent": {},
			"minecraft:fire_immune": {},
