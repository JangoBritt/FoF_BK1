{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "medieval:cherry_cabinet_tall",
			"menu_category": {
				"category": "items",
				"group": "medFur:cabinetTall"
			},
			"traits": {
				"minecraft:placement_direction": { "enabled_states": [ "minecraft:cardinal_direction" ], "y_rotation_offset": 180 }
			},
			"states": {
				"medieval:placed": [ false, true ],
				"medieval:side": [ false, true ]
			}
		},
		"permutations": [
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'north'", "components": {"minecraft:transformation": {"rotation": [0,0,0]}}},
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'south'", "components": {"minecraft:transformation": {"rotation": [0,180,0]}}},
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'west'", "components": {"minecraft:transformation": {"rotation": [0,90,0]}}},
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'east'", "components": {"minecraft:transformation": {"rotation": [0,-90,0]}}},
			{ "condition": "q.block_state('medieval:placed')", "components": { "minecraft:placement_filter": { "conditions": [ { "allowed_faces": [ "down" ], "block_filter": [ "medieval:cherry_cabinet_tall_top" ] } ] } } },
			{ "condition": "!q.block_state('medieval:side')", "components": { "tag:mf:cabinet_tall": {} }}
		],
		"components": {
			"tag:minecraft:is_axe_item_destructible": {},
			"minecraft:geometry": {
				"identifier": "geometry.mf.cabinet_tall_bot",
				"bone_visibility": {
					"close": "!q.block_state('medieval:placed') && !q.block_state('medieval:side')",
					"sclose": "!q.block_state('medieval:placed') && q.block_state('medieval:side')"
				}
			},
			"minecraft:material_instances": {
				"*": { "texture": "mf:stripped_cherry", "render_method": "alpha_test" },
				"planks": { "texture": "mf:cherry_planks", "render_method": "alpha_test" },
				"metal": { "texture": "mf:light_gray_concrete", "render_method": "alpha_test" }
			},
			"minecraft:item_visual": {
				"geometry": "geometry.mf.cabinet_tall",
				"material_instances": {
					"*": { "texture": "mf:stripped_cherry", "render_method": "alpha_test" },
					"planks": { "texture": "mf:cherry_planks", "render_method": "alpha_test" },
					"metal": { "texture": "mf:light_gray_concrete", "render_method": "alpha_test" }
				}
			},
			"minecraft:light_dampening": 0,
			"minecraft:liquid_detection": { "detection_rules": [ {
				"can_contain_liquid": true,
				"liquid_type": "water",
				"on_liquid_touches": "blocking"
			} ] },
			"minecraft:redstone_conductivity": {
				"allows_wire_to_step_down": false,
				"redstone_conductor": false
			},
			"minecraft:flammable": { "catch_chance_modifier": 5, "destroy_chance_modifier": 5 },
			"minecraft:destructible_by_explosion": { "explosion_resistance": 3.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 3.0 },
			"minecraft:custom_components": [ "mf:cabinet_add_armor", "mf:cabinet_tall" ],
			"minecraft:map_color": "#ffb5e0"
		}
	}
}