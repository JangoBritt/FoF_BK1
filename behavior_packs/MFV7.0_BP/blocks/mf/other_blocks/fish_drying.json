{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "medieval:fish_drying",
			"menu_category": {
				"category": "equipment",
				"group": "medFur:miscBlocks"
			},
			"traits": {
				"minecraft:placement_direction": { "enabled_states": [ "minecraft:cardinal_direction" ] }
			},
			"states": {
				"medieval:side": [1,2,3,4],
				"medieval:fish_left": [0,1,2],
				"medieval:fish_right": [0,1,2]
			}
		},
		"permutations": [
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'north'", "components": { "minecraft:transformation": { "rotation": [ 0, 0, 0 ] } } },
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'south'", "components": { "minecraft:transformation": { "rotation": [ 0, 180, 0 ] } } },
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'west'", "components": { "minecraft:transformation": { "rotation": [ 0, 90, 0 ] } } },
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'east'", "components": { "minecraft:transformation": { "rotation": [ 0, -90, 0 ] } } },
			{ "condition": "(q.block_state('medieval:fish_left') == 1 && q.block_state('medieval:fish_right') == 0) || (q.block_state('medieval:fish_left') == 0 && q.block_state('medieval:fish_right') == 1) || (q.block_state('medieval:fish_left') == 1 && q.block_state('medieval:fish_right') == 1)", "components": {
				"minecraft:material_instances": {
					"*": { "texture": "mf:stripped_spruce", "render_method": "alpha_test" },
					"string": { "texture": "mf:winch", "render_method": "alpha_test", "ambient_occlusion": false },
					"fish_left": { "texture": "mf:salmon", "render_method": "alpha_test", "ambient_occlusion": false },
					"fish_right": { "texture": "mf:salmon", "render_method": "alpha_test", "ambient_occlusion": false }
				}
			} },
			{ "condition": "(q.block_state('medieval:fish_left') == 2 && q.block_state('medieval:fish_right') == 0) || (q.block_state('medieval:fish_left') == 0 && q.block_state('medieval:fish_right') == 2) || (q.block_state('medieval:fish_left') == 2 && q.block_state('medieval:fish_right') == 2)", "components": {
				"minecraft:material_instances": {
					"*": { "texture": "mf:stripped_spruce", "render_method": "alpha_test" },
					"string": { "texture": "mf:winch", "render_method": "alpha_test", "ambient_occlusion": false },
					"fish_left": { "texture": "mf:cod", "render_method": "alpha_test", "ambient_occlusion": false },
					"fish_right": { "texture": "mf:cod", "render_method": "alpha_test", "ambient_occlusion": false }
				}
			} },
			{ "condition": "q.block_state('medieval:fish_left') == 1 && q.block_state('medieval:fish_right') == 2", "components": {
				"minecraft:material_instances": {
					"*": { "texture": "mf:stripped_spruce", "render_method": "alpha_test" },
					"string": { "texture": "mf:winch", "render_method": "alpha_test", "ambient_occlusion": false },
					"fish_left": { "texture": "mf:salmon", "render_method": "alpha_test", "ambient_occlusion": false },
					"fish_right": { "texture": "mf:cod", "render_method": "alpha_test", "ambient_occlusion": false }
				}
			} },
			{ "condition": "q.block_state('medieval:fish_left') == 2 && q.block_state('medieval:fish_right') == 1", "components": {
				"minecraft:material_instances": {
					"*": { "texture": "mf:stripped_spruce", "render_method": "alpha_test" },
					"string": { "texture": "mf:winch", "render_method": "alpha_test", "ambient_occlusion": false },
					"fish_left": { "texture": "mf:cod", "render_method": "alpha_test", "ambient_occlusion": false },
					"fish_right": { "texture": "mf:salmon", "render_method": "alpha_test", "ambient_occlusion": false }
				}
			} }
		],
		"components": {
			"tag:minecraft:is_axe_item_destructible": {},
			"minecraft:geometry": {
				"identifier": "geometry.mf.fish_drying",
				"bone_visibility": {
					"right": "q.block_state('medieval:side') == 1 || q.block_state('medieval:side') == 2",
					"left": "q.block_state('medieval:side') == 1 || q.block_state('medieval:side') == 3",
					"fish_right": "q.block_state('medieval:fish_right') > 0",
					"fish_left": "q.block_state('medieval:fish_left') > 0"
				}
			},
			"minecraft:material_instances": {
				"*": { "texture": "mf:stripped_spruce", "render_method": "alpha_test" },
				"string": { "texture": "mf:winch", "render_method": "alpha_test", "ambient_occlusion": false },
				"fish_left": { "texture": "mf:salmon", "render_method": "alpha_test", "ambient_occlusion": false },
				"fish_right": { "texture": "mf:salmon", "render_method": "alpha_test", "ambient_occlusion": false }
			},
			"minecraft:collision_box": true,
			"minecraft:selection_box": true,
			"minecraft:light_dampening": 0,
			"minecraft:liquid_detection": { "detection_rules": [ {
				"can_contain_liquid": true,
				"liquid_type": "water",
				"on_liquid_touches": "blocking"
			} ] },
			"minecraft:redstone_conductivity": {
				"allows_wire_to_step_down": false,
				"redstone_conductor": false
			},
			"minecraft:flammable": { "catch_chance_modifier": 5, "destroy_chance_modifier": 5 },
			"minecraft:destructible_by_explosion": { "explosion_resistance": 3.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 3.0 },
			"minecraft:custom_components": [ "mf:fish_drying" ],
			"minecraft:map_color": "#f7781e"
		}
	}
}