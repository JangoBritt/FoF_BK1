			"minecraft:geometry": {
				"identifier": "geometry.mf.portcullis_block",
				"bone_visibility": {
					"bottom": "!q.block_state('mf:top')",
					"top": "q.block_state('mf:top')"
				}
			},
			"minecraft:material_instances": { "*": { "texture": "mf:portcullis", "render_method": "alpha_test", "ambient_occlusion": false } },
			"minecraft:collision_box": { "origin": [-8, 0, -2], "size": [16, 16, 4] },
			"minecraft:selection_box": { "origin": [-8, 0, -2], "size": [16, 16, 4] },
			"minecraft:light_dampening": 0,
			"minecraft:liquid_detection": { "detection_rules": [ {
				"can_contain_liquid": true,
				"liquid_type": "water",
				"on_liquid_touches": "blocking"
			} ] },
			"minecraft:redstone_conductivity": {
				"allows_wire_to_step_down": false,
				"redstone_conductor": false
			},
			"minecraft:destructible_by_explosion": { "explosion_resistance": 10.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 8.0 },
			"minecraft:custom_components": [ "mf:portcullis" ],
			"minecraft:map_color": "#6c4636"
		}
