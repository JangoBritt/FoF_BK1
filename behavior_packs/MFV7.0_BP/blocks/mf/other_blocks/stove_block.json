{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "medieval:stove_visual",
			"menu_category": {
				"category": "none",
				"is_hidden_in_commands": true
			},
			"traits": {"minecraft:placement_direction": {"enabled_states": ["minecraft:cardinal_direction"],"y_rotation_offset": 180}},
