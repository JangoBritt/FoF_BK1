				"mc:block_parts": [ 0, 1 ]
			}
		},
		"permutations": [
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'north'","components": {"minecraft:transformation": {"rotation": [0,0,0] }}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'south'","components": {"minecraft:transformation": {"rotation": [0,180,0] }}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'west'","components": {"minecraft:transformation": {"rotation": [0,90,0] }}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'east'","components": {"minecraft:transformation": {"rotation": [0,-90,0] }}},
			{"condition": "!q.block_state('medieval:stove_on')","components": {"minecraft:material_instances": {"*": {"texture": "mf:stove","render_method": "alpha_test","ambient_occlusion": false},"coal_lit": {"texture": "mf:stove_coal","render_method": "alpha_test","ambient_occlusion": false},"fire": {"texture": "campfire_fire","render_method": "alpha_test","ambient_occlusion": false,"face_dimming": false}},"minecraft:light_emission": 0}},
			{"condition": "q.block_state('medieval:stove_on')","components": { "minecraft:light_emission": 15 }},
			{"condition": "q.block_state('mc:block_parts') == 0", "components": {
				"minecraft:placement_filter": {"conditions": [
					{
						"allowed_faces": ["east"],
						"block_filter": [{"name": "medieval:stove_visual","states": {"minecraft:cardinal_direction": "north", "mc:block_parts": 1}}]
					},
					{
						"allowed_faces": ["west"],
						"block_filter": [{"name": "medieval:stove_visual","states": {"minecraft:cardinal_direction": "south", "mc:block_parts": 1}}]
					},
					{
						"allowed_faces": ["south"],
						"block_filter": [{"name": "medieval:stove_visual","states": {"minecraft:cardinal_direction": "east", "mc:block_parts": 1}}]
					},
					{
						"allowed_faces": ["north"],
						"block_filter": [{"name": "medieval:stove_visual","states": {"minecraft:cardinal_direction": "west", "mc:block_parts": 1}}]
					}
				]}
			}},
			{"condition": "q.block_state('mc:block_parts') == 1", "components": {
				"minecraft:placement_filter": {"conditions": [
					{
						"allowed_faces": ["west"],
						"block_filter": [{"name": "medieval:stove_visual","states": {"minecraft:cardinal_direction": "north", "mc:block_parts": 0}}]
					},
					{
						"allowed_faces": ["east"],
						"block_filter": [{"name": "medieval:stove_visual","states": {"minecraft:cardinal_direction": "south", "mc:block_parts": 0}}]
					},
					{
						"allowed_faces": ["south"],
						"block_filter": [{"name": "medieval:stove_visual","states": {"minecraft:cardinal_direction": "west", "mc:block_parts": 0}}]
					},
					{
						"allowed_faces": ["north"],
						"block_filter": [{"name": "medieval:stove_visual","states": {"minecraft:cardinal_direction": "east", "mc:block_parts": 0}}]
					}
				]}
			}}
		],
		"components": {
			"tag:farmersdelight:heat_source": {},
			"tag:minecraft:is_pickaxe_item_destructible": {},
			"minecraft:geometry": {
				"identifier": "geometry.mf.stove",
				"bone_visibility": {
					"part_0": "q.block_state('mc:block_parts') == 0",
					"part_1": "q.block_state('mc:block_parts') == 1"
				}
			},
			"minecraft:display_name": "mc.unobtainable_block.name",
			"minecraft:loot": "loot_tables/empty.json",
			"minecraft:material_instances": {"*": {"texture": "mf:stove","render_method": "alpha_test","ambient_occlusion": false},"coal_lit": {"texture": "mf:coal_lit","render_method": "alpha_test","ambient_occlusion": false},"fire": {"texture": "campfire_fire","render_method": "alpha_test","ambient_occlusion": false,"face_dimming": false}},
			"minecraft:collision_box": true,
			"minecraft:selection_box": true,
			"minecraft:light_dampening": 0,
			"minecraft:light_emission": 0,
			"minecraft:destructible_by_explosion": { "explosion_resistance": 6.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 4.0 },
			"minecraft:custom_components": [ "mf:break_big_block", "mf:stove" ],
			"minecraft:map_color": "#24abab"
		}
	}
}