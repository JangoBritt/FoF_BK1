{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "medieval:stripped_cherry_weapon_stand",
			"menu_category": {
				"category": "items",
				"group": "medFur:weaponStands"
			},
			"traits": {
				"minecraft:placement_direction": { "enabled_states": [ "minecraft:cardinal_direction" ], "y_rotation_offset": 180 }
			},
			"states": {
				"mf:placed": [ false, true ]
			}
		},
		"permutations": [
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'north'", "components": { "minecraft:transformation": { "rotation": [ 0, 0,0 ] } } },
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'south'", "components": { "minecraft:transformation": { "rotation": [ 0, 180,0 ] } } },
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'west'", "components": { "minecraft:transformation": { "rotation": [ 0, 90,0 ] } } },
			{ "condition": "q.block_state('minecraft:cardinal_direction') == 'east'", "components": { "minecraft:transformation": { "rotation": [ 0, -90,0 ] } } },
			{ "condition": "q.block_state('mf:placed')", "components": {
				"minecraft:placement_filter": { "conditions": [
					{ "allowed_faces": [ "east" ], "block_filter": [ { "name": "medieval:stripped_cherry_weapon_stand_side", "states": { "minecraft:cardinal_direction": "north" } } ] },
					{ "allowed_faces": [ "west" ], "block_filter": [ { "name": "medieval:stripped_cherry_weapon_stand_side", "states": { "minecraft:cardinal_direction": "south" } } ] },
					{ "allowed_faces": [ "north" ], "block_filter": [ { "name": "medieval:stripped_cherry_weapon_stand_side", "states": { "minecraft:cardinal_direction": "west" } } ] },
					{ "allowed_faces": [ "south" ], "block_filter": [ { "name": "medieval:stripped_cherry_weapon_stand_side", "states": { "minecraft:cardinal_direction": "east" } } ] }
				] } }
			}
		],
		"components": {
			"tag:minecraft:is_axe_item_destructible": {},
			"minecraft:geometry": "geometry.mf.weapon_stand_left",
			"minecraft:item_visual": {
				"geometry": "geometry.mf.weapon_stand",
				"material_instances": { "*": { "texture": "mf:stripped_cherry", "render_method": "opaque" }, "planks": { "texture": "mf:cherry_planks", "render_method": "opaque" } }
			},
			"minecraft:material_instances": { "*": { "texture": "mf:stripped_cherry", "render_method": "opaque" }, "planks": { "texture": "mf:cherry_planks", "render_method": "opaque" } },
			"minecraft:collision_box": { "origin": [-8, 0, -5], "size": [16, 16, 13] },
			"minecraft:selection_box": { "origin": [-8, 0, -5], "size": [16, 16, 13] },
			"minecraft:light_dampening": 0,
			"minecraft:liquid_detection": { "detection_rules": [ {
				"can_contain_liquid": true,
				"liquid_type": "water",
				"on_liquid_touches": "blocking"
			} ] },
			"minecraft:redstone_conductivity": {
				"allows_wire_to_step_down": false,
				"redstone_conductor": false
			},
			"minecraft:flammable": { "catch_chance_modifier": 5, "destroy_chance_modifier": 5 },
			"minecraft:destructible_by_explosion": { "explosion_resistance": 3.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 3.0 },
			"minecraft:custom_components": [ "mf:weapon_stand", "mf:wepapon_stand_i" ],
			"minecraft:map_color": "#ffb5e0"
		}
	}
}