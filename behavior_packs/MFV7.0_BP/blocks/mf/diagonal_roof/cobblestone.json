{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "medieval:cobblestone_diagonal_roof",
			"menu_category": {
				"category": "construction",
				"group": "medFur:diagonalRoofs"
			},
			"traits": {
				"minecraft:placement_direction": { "enabled_states": [ "minecraft:cardinal_direction" ], "y_rotation_offset": 180 }
			},
			"states": {
				"mf:shape": ["straight", "inner_left", "inner_right", "outer_left", "outer_right"]
			}
		},
		"permutations": [
			{ "condition": "(q.block_state('minecraft:cardinal_direction') == 'north' && (q.block_state('mf:shape') == 'straight' || q.block_state('mf:shape') == 'inner_right' || q.block_state('mf:shape') == 'outer_right')) || (q.block_state('minecraft:cardinal_direction') == 'east' && (q.block_state('mf:shape') == 'inner_left' || q.block_state('mf:shape') == 'outer_left'))", "components": { "minecraft:transformation": { "rotation": [ 0, 0, 0 ] } } },
			{ "condition": "(q.block_state('minecraft:cardinal_direction') == 'north' && (q.block_state('mf:shape') == 'inner_left' || q.block_state('mf:shape') == 'outer_left')) || (q.block_state('minecraft:cardinal_direction') == 'west' && (q.block_state('mf:shape') == 'straight' || q.block_state('mf:shape') == 'inner_right' || q.block_state('mf:shape') == 'outer_right'))", "components": { "minecraft:transformation": { "rotation": [ 0, 90, 0 ] } } },
			{ "condition": "(q.block_state('minecraft:cardinal_direction') == 'south' && (q.block_state('mf:shape') == 'straight' || q.block_state('mf:shape') == 'inner_right' || q.block_state('mf:shape') == 'outer_right')) || (q.block_state('minecraft:cardinal_direction') == 'west' && (q.block_state('mf:shape') == 'inner_left' || q.block_state('mf:shape') == 'outer_left'))", "components": { "minecraft:transformation": { "rotation": [ 0, 180, 0 ] } } },
			{ "condition": "(q.block_state('minecraft:cardinal_direction') == 'south' && (q.block_state('mf:shape') == 'inner_left' || q.block_state('mf:shape') == 'outer_left')) || (q.block_state('minecraft:cardinal_direction') == 'east' && (q.block_state('mf:shape') == 'straight' || q.block_state('mf:shape') == 'inner_right' || q.block_state('mf:shape') == 'outer_right'))", "components": { "minecraft:transformation": { "rotation": [ 0, -90, 0 ] } } }
		],
		"components": {
			"tag:mf:diagonal_roof": {},
			"tag:minecraft:is_pickaxe_item_destructible": {},
			"minecraft:geometry": {
				"identifier": "geometry.mf.diagonal_roof",
				"bone_visibility": {
					"inner": "q.block_state('mf:shape') == 'inner_left' || q.block_state('mf:shape') == 'inner_right'",
					"outer": "q.block_state('mf:shape') == 'outer_left' || q.block_state('mf:shape') == 'outer_right'",
					"normal": "q.block_state('mf:shape') == 'straight'"
				}
			},
			"minecraft:material_instances": { "*": { "texture": "mf:cobblestone", "render_method": "alpha_test", "ambient_occlusion": false } },
			"minecraft:collision_box": true,
			"minecraft:selection_box": true,
			"minecraft:light_dampening": 0,
			"minecraft:liquid_detection": { "detection_rules": [ {
				"can_contain_liquid": true,
				"liquid_type": "water",
				"on_liquid_touches": "blocking"
			} ] },
			"minecraft:redstone_conductivity": {
				"allows_wire_to_step_down": false,
				"redstone_conductor": false
			},
			"minecraft:destructible_by_explosion": { "explosion_resistance": 6.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 4.0 },
			"minecraft:custom_components": [ "mf:diagonal_roofs" ],
			"minecraft:map_color": "#888788"
		}
	}
}