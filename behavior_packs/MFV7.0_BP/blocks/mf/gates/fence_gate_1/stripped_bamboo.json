{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "medieval:stripped_bamboo_gate1",
			"menu_category": {
				"category": "construction",
				"group": "medFur:fenceGate2"
			},
			"states": {
				"medieval:facing_direction": [ 2, 3, 4, 5 ],
				"medieval:state": [ 0, 1, 2 ],
				"medieval:close": [ true, false ]
			}
		},
		"permutations": [
			{ "condition": "q.block_state('medieval:facing_direction') == 2", "components": { "minecraft:transformation": { "rotation": [ 0, 0, 0 ] } } },
			{ "condition": "q.block_state('medieval:facing_direction') == 3", "components": { "minecraft:transformation": { "rotation": [ 0, 180, 0 ] } } },
			{ "condition": "q.block_state('medieval:facing_direction') == 4", "components": { "minecraft:transformation": { "rotation": [ 0, 90, 0 ] } } },
			{ "condition": "q.block_state('medieval:facing_direction') == 5", "components": { "minecraft:transformation": { "rotation": [ 0, -90, 0 ] } } },
			{ "condition": "!q.block_state('medieval:close')", "components": { "minecraft:collision_box": false } }
		],
		"components": {
			"tag:mc:solid_block": {},
			"tag:minecraft:is_axe_item_destructible": {},
			"minecraft:geometry": {
				"identifier": "geometry.mf.fence_gate_2",
				"bone_visibility": {
					"01": "q.block_state('medieval:state') == 0 || q.block_state('medieval:state') == 1",
					"02": "q.block_state('medieval:state') == 0 || q.block_state('medieval:state') == 2",
					"2": "q.block_state('medieval:state') == 2",
					"close0": "q.block_state('medieval:state') == 0 && q.block_state('medieval:close')",
					"open0": "q.block_state('medieval:state') == 0 && !q.block_state('medieval:close')",
					"close1": "q.block_state('medieval:state') == 1 && q.block_state('medieval:close')",
					"open1": "q.block_state('medieval:state') == 1 && !q.block_state('medieval:close')",
					"close2": "q.block_state('medieval:state') == 2 && q.block_state('medieval:close')",
					"open2": "q.block_state('medieval:state') == 2 && !q.block_state('medieval:close')"
				}
			},
			"minecraft:material_instances": {
				"*": { "texture": "mf:stripped_bamboo", "render_method": "opaque" },
				"metal": { "texture": "mf:light_gray_concrete", "render_method": "opaque" }
			},
			"minecraft:collision_box": { "origin": [ -8, 0, -2 ], "size": [ 16, 16, 4 ] },
			"minecraft:selection_box": { "origin": [ -8, 0, -2 ], "size": [ 16, 16, 4 ] },
			"minecraft:light_dampening": 0,
			"minecraft:liquid_detection": { "detection_rules": [ {
				"can_contain_liquid": true,
				"liquid_type": "water",
				"on_liquid_touches": "blocking"
			} ] },
			"minecraft:redstone_conductivity": {
				"allows_wire_to_step_down": false,
				"redstone_conductor": false
			},
			"minecraft:flammable": { "catch_chance_modifier": 5, "destroy_chance_modifier": 5 },
			"minecraft:destructible_by_explosion": { "explosion_resistance": 3.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 3.0 },
			"minecraft:custom_components": ["mf:old_rotation2", "mf:fence_gate", "mf:fence_gate_connection"],
			"minecraft:map_color": "#ecf08d"
		}
	}
}