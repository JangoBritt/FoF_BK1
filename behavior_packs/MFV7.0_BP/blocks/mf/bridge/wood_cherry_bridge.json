{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "medieval:wood_cherry_bridge",
			"menu_category": {
				"category": "items",
				"group": "medFur:bridges"
			},
			"states": {
				"medieval:facing_direction": [ 1, 2 ],
				"medieval:length": [ 0, 1, 2, 3 ],
				"medieval:width": [ 0, 1, 2, 3 ]
			}
		},
		"permutations": [
			{ "condition": "q.block_state('medieval:facing_direction') == 1", "components": {
				"minecraft:transformation": { "rotation": [ 0, 0, 0 ] },
				"tag:cherry_bridge_ns": {},
				"minecraft:liquid_detection": { "detection_rules": [ {
					"can_contain_liquid": true,
					"liquid_type": "water",
					"on_liquid_touches": "blocking",
					"stops_liquid_flowing_from_direction": [ "down", "west", "east" ]
				} ] }
			} },
			{ "condition": "q.block_state('medieval:facing_direction') == 2", "components": {
				"minecraft:transformation": { "rotation": [ 0, 90, 0 ] },
				"tag:cherry_bridge_ew": {},
				"minecraft:liquid_detection": { "detection_rules": [ {
					"can_contain_liquid": true,
					"liquid_type": "water",
					"on_liquid_touches": "blocking",
					"stops_liquid_flowing_from_direction": [ "down", "north", "south" ]
				} ] }
			} },
			{ "condition": "q.block_state('medieval:width') == 3", "components": {
				"minecraft:collision_box": { "origin": [ -8, 0, -8 ], "size": [ 16, 4, 16 ] },
				"minecraft:selection_box": { "origin": [ -8, 0, -8 ], "size": [ 16, 4, 16 ] }
			} }
		],
		"components": {
			"tag:minecraft:is_axe_item_destructible": {},
			"minecraft:geometry": {
				"identifier": "geometry.mf.bridge_0",
				"bone_visibility": {
					"lenght_r0": "q.block_state('medieval:length') == 0 && (q.block_state('medieval:width') == 0 || q.block_state('medieval:width') == 1)",
					"lenght_l0": "q.block_state('medieval:length') == 0 && (q.block_state('medieval:width') == 0 || q.block_state('medieval:width') == 2)",
					"lenght_r1": "q.block_state('medieval:length') == 1 && (q.block_state('medieval:width') == 0 || q.block_state('medieval:width') == 1)",
					"lenght_l1": "q.block_state('medieval:length') == 1 && (q.block_state('medieval:width') == 0 || q.block_state('medieval:width') == 2)",
					"lenght_r2": "q.block_state('medieval:length') == 2 && (q.block_state('medieval:width') == 0 || q.block_state('medieval:width') == 1)",
					"lenght_l2": "q.block_state('medieval:length') == 2 && (q.block_state('medieval:width') == 0 || q.block_state('medieval:width') == 2)",
					"lenght_r3": "q.block_state('medieval:length') == 3 && (q.block_state('medieval:width') == 0 || q.block_state('medieval:width') == 1)",
					"lenght_l3": "q.block_state('medieval:length') == 3 && (q.block_state('medieval:width') == 0 || q.block_state('medieval:width') == 2)"
				}
			},
			"minecraft:material_instances": {
				"*": { "texture": "mf:wood_cherry", "render_method": "opaque" },
				"planks": { "texture": "mf:cherry_planks", "render_method": "opaque" }
			},
			"minecraft:collision_box": { "origin": [ -8, 0, -8 ], "size": [ 16, 4, 16 ] },
			"minecraft:selection_box": true,
			"minecraft:light_dampening": 0,
			"minecraft:redstone_conductivity": {
				"allows_wire_to_step_down": false,
				"redstone_conductor": false
			},
			"minecraft:flammable": { "catch_chance_modifier": 5, "destroy_chance_modifier": 5 },
			"minecraft:destructible_by_explosion": { "explosion_resistance": 3.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 4.0 },
			"minecraft:custom_components": [ "mf:simple_rotation", "mf:bridge_detection" ],
			"minecraft:map_color": "#ffb5e0"
		}
	}
}