{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "medieval:emerald_chandelier",
			"menu_category": {
				"category": "items",
				"group": "medFur:candleholderWall"
			},
			"traits": {
				"minecraft:placement_position": { "enabled_states": [ "minecraft:block_face" ] }
			},
			"states": {
				"medieval:facing_direction": [ 1, 2 ]
			}
		},
		"permutations": [
			{"condition": "q.block_state('minecraft:block_face') == 'north'","components":{"minecraft:transformation":{"rotation": [0,180,0]}}},
			{"condition": "q.block_state('minecraft:block_face') == 'south'","components":{"minecraft:transformation":{"rotation": [0,0,0]}}},
			{"condition": "q.block_state('minecraft:block_face') == 'west'","components":{"minecraft:transformation":{"rotation": [0,-90,0]}}},
			{"condition": "q.block_state('minecraft:block_face') == 'east'","components":{"minecraft:transformation":{"rotation": [0,90,0]}}},
			{"condition": "q.block_state('medieval:facing_direction') == 1 && q.block_state('minecraft:block_face') == 'up'","components": { "minecraft:transformation": {"rotation": [0,0,0]}}},
			{"condition": "q.block_state('medieval:facing_direction') == 2 && q.block_state('minecraft:block_face') == 'up'","components": { "minecraft:transformation": {"rotation": [0,90,0]}}},
			{"condition": "q.block_state('minecraft:block_face') != 'up'","components": {
				"minecraft:geometry": "geometry.mf.candleholder_wall",
				"minecraft:collision_box": { "origin": [-8, 0, -8 ], "size": [ 16, 10, 7 ] },
				"minecraft:selection_box": { "origin": [-8, 0, -8 ], "size": [ 16, 16, 7 ] },
				"minecraft:material_instances": {
					"*": {"texture": "mf:candleholder_wall_emerald","render_method": "alpha_test","ambient_occlusion": false},
					"candle": {"texture": "mf:candle_normal","render_method": "alpha_test","ambient_occlusion": false},
					"fire_candle": {"texture": "mf:fire_candle","render_method": "alpha_test","ambient_occlusion": false,"face_dimming": false}
				}
			}}
		],
		"components": {
			"minecraft:geometry": "geometry.mf.candleholder_3",
			"minecraft:material_instances": {
				"*": {"texture": "mf:candleholder_3_emerald","render_method": "alpha_test","ambient_occlusion": false},
				"candle": {"texture": "mf:candle_normal","render_method": "alpha_test","ambient_occlusion": false},
				"fire_candle": {"texture": "mf:fire_candle","render_method": "alpha_test","ambient_occlusion": false,"face_dimming": false}
			},
			"minecraft:item_visual": {
				"geometry": "geometry.mf.candleholder_3",
				"material_instances": {
					"*": {"texture": "mf:candleholder_3_emerald","render_method": "alpha_test","ambient_occlusion": false},
					"candle": {"texture": "mf:candle_normal","render_method": "alpha_test","ambient_occlusion": false},
					"fire_candle": {"texture": "mf:fire_candle","render_method": "alpha_test","ambient_occlusion": false,"face_dimming": false}
				}
			},
			"minecraft:collision_box": { "origin": [ -8, 0, -3 ], "size": [ 16, 10, 6 ] },
			"minecraft:selection_box": { "origin": [ -8, 0, -3 ], "size": [ 16, 16, 6 ] },
			"minecraft:placement_filter": {"conditions": [{"allowed_faces": ["side","up"]}]},
			"minecraft:light_emission": 15,
			"minecraft:light_dampening": 0,
			"minecraft:liquid_detection": { "detection_rules": [ {
				"can_contain_liquid": true,
				"liquid_type": "water",
				"on_liquid_touches": "popped"
			} ] },
			"minecraft:redstone_conductivity": {
				"allows_wire_to_step_down": false,
				"redstone_conductor": false
			},
			"minecraft:destructible_by_explosion": { "explosion_resistance": 3.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 0 },
			"minecraft:custom_components": [ "mf:simple_rotation" ],
			"minecraft:map_color": "#00a529"
		}
	}
}