{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "medieval:warped_wood_post",
			"menu_category": {
				"category": "nature",
				"group": "medFur:stickPost"
			},
			"states": {
				"medieval:facing_direction": [ 0, 1, 2, 3, 4, 5, 6, 7 ]
			}
		},
		"permutations": [
			{  "condition": "q.block_state('medieval:facing_direction') == 2 || q.block_state('medieval:facing_direction') == 0", "components": { "minecraft:transformation": { "rotation": [ 0, 180, 0 ] } } },
			{"condition": "q.block_state('medieval:facing_direction') == 3 || q.block_state('medieval:facing_direction') == 1", "components": { "minecraft:transformation": { "rotation": [ 0, 0, 0 ] } } },
			{ "condition": "q.block_state('medieval:facing_direction') == 4 || q.block_state('medieval:facing_direction') == 6", "components": { "minecraft:transformation": { "rotation": [ 0, -90, 0 ] } } },
			{ "condition": "q.block_state('medieval:facing_direction') == 5 || q.block_state('medieval:facing_direction') == 7", "components": { "minecraft:transformation": { "rotation": [ 0, 90, 0 ] } } },
			{"condition": "!(q.block_state('medieval:facing_direction') >= 2 && q.block_state('medieval:facing_direction') <= 5)","components": {
				"minecraft:collision_box": { "origin": [ -2, 0, 4 ], "size": [ 4, 16, 4 ] },
				"minecraft:selection_box": { "origin": [ -2, 0, 4 ], "size": [ 4, 16, 4 ] }
			}}
		],
		"components": {
			"tag:minecraft:is_axe_item_destructible": {},
			"minecraft:geometry": {
				"identifier": "geometry.mf.stick_post",
				"bone_visibility": {
					"center": "!(q.block_state('medieval:facing_direction') >= 2 && q.block_state('medieval:facing_direction') <= 5)",
					"corner": "q.block_state('medieval:facing_direction') >= 2 && q.block_state('medieval:facing_direction') <= 5"
				}
			},
			"minecraft:material_instances": { "*": { "texture": "mf:wood_warped", "render_method": "opaque" } },
			"minecraft:collision_box": { "origin": [ -8, 0, 4 ], "size": [ 4, 16, 4 ] },
			"minecraft:selection_box": { "origin": [ -8, 0, 4 ], "size": [ 4, 16, 4 ] },
			"minecraft:light_dampening": 0,
			"minecraft:liquid_detection": { "detection_rules": [ {
				"can_contain_liquid": true,
				"liquid_type": "water",
				"on_liquid_touches": "no_reaction"
			} ] },
			"minecraft:redstone_conductivity": {
				"allows_wire_to_step_down": false,
				"redstone_conductor": false
			},
			"minecraft:flammable": { "catch_chance_modifier": 5, "destroy_chance_modifier": 5 },
			"minecraft:destructible_by_explosion": { "explosion_resistance": 3.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 4.0 },
			"minecraft:custom_components": [ "mf:stick_post" ],
			"minecraft:map_color": "#228579"
		}
	}
}