{
	"format_version": "1.8.0",
	"minecraft:spawn_rules": {
		"description": {
			"identifier": "fof:reindeer",
			"population_control": "animal"
		},
		"conditions": [
			{
				"minecraft:spawns_on_surface": {},
				"minecraft:spawns_on_block_filter": [
					"minecraft:grass_block",
					"minecraft:snow",
					"minecraft:sand",
					"minecraft:snow_layer"		
				],
				"minecraft:brightness_filter": {
					"min": 7,
					"max": 15,
					"adjust_for_weather": false
				},
				"minecraft:weight": {
					"default": 2
				},
				"minecraft:herd": {
					"min_size": 2,
					"max_size": 5
				},
				"minecraft:biome_filter": {
					"any_of": [
						{
							"test": "has_biome_tag",
							"operator": "==",
							"value": "frozen"
						},
						{
							"test": "has_biome_tag",
							"operator": "==",
							"value": "cold"
						},
						{
							"test": "has_biome_tag",
							"operator": "==",
							"value": "snowy_plains"
						},
						{ "test": "is_snow_covered" }
					]
				}
			}
		]
	}
}