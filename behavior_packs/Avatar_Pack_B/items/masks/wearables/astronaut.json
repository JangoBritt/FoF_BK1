{
	"format_version": "1.21.30",
	"minecraft:item": {
		"description": {
			"identifier": "fables_avatars:astronaut_mask",
			"menu_category": {
				"category": "equipment",
				"group": "minecraft:itemGroup.name.helmet"
			}
		},
		"components": {
			"minecraft:max_stack_size": 1,
			"minecraft:enchantable": {
				"value": 9,
				"slot": "armor_head"
			},
			"minecraft:durability": {
				"max_durability": 165,
				"damage_chance": {
					"min": 60,
					"max": 100
				}
			},
			"minecraft:icon": {
				"textures": {
					"default": "astronaut_item",
					"dyed": "astronaut_item"
				}
			},
			"minecraft:wearable": {
				"protection": 4,
				"slot": "slot.armor.head"
			},
			"minecraft:creative_category": {
				"parent": "itemGroup.name.mask"
			},
			"minecraft:tags": {
				"tags": [
					"minecraft:is_armor",
					"minecraft:trimmable_armors"
				]
			},
			"minecraft:dyeable": {
  				"default_color":  "#ffffff"
			},
			"minecraft:repairable": {
				"repair_items": [
					{
						"items": [
							"minecraft:iron_ingot"
						],
						"repair_amount": "query.max_durability * 0.25"
					},
					{
						"items": [
							"fables_avatars:astronaut_mask"
						],
						"repair_amount": "context.other->query.remaining_durability + 0.12 * context.other->query.max_durability"
					}
				]
			}
		}
	}
}
