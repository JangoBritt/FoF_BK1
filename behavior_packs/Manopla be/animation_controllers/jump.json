{
  "format_version":"1.10.0",
  "animation_controllers":{
    "controller.animation.manopla": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {"loop": "query.get_equipped_item_name=='manopla' && q.is_using_item"}
          ],
          "on_entry": [
            "/camera @s clear"
          ]
        },
        "loop": {
          "transitions": [
            {"loop2": "!q.is_on_ground"}
          ],
          "on_entry": [
            "/particle wesl3y:manopla",
            "/effect @s levitation 1 14 true",
            "/playanimation @s animation.manopla.special wg"
          ]
        },
        "loop2": {
          "transitions": [
            {"loop3": "q.is_on_ground"}
          ]
        },
        "loop3": {
          "transitions": [
            {"default": "!q.is_using_item"}
          ],
          "on_entry": [
            "/camerashake add @a[r=10] 0.6 2 positional",
            "/particle wesl3y:manopla2",
            "/particle wesl3y:manopla3",
            "/damage @e[family=!player,rm=1,r=5] 16 fly_into_wall entity @s",
            "/fill ~ ~-1 ~ ~ ~-1 ~ minecraft:gravel replace minecraft:cobblestone",
            "/fill ~ ~-1 ~ ~ ~-1 ~ minecraft:cobblestone replace minecraft:stone",
            "/fill ~ ~-1 ~ ~ ~-1 ~ minecraft:cracked_stone_bricks replace minecraft:stone_bricks",
            "/fill ~ ~-1 ~ ~ ~-1 ~ minecraft:cracked_deepslate_bricks replace minecraft:deepslate_bricks",
            "/fill ~ ~-1 ~ ~ ~-1 ~ minecraft:cracked_deepslate_tiles replace minecraft:deepslate_tiles",
            "/fill ~ ~-1 ~ ~ ~-1 ~ minecraft:cracked_nether_bricks replace minecraft:nether_brick",
            "/fill ~ ~-1 ~ ~ ~-1 ~ minecraft:cracked_polished_blackstone_bricks replace minecraft:polished_blackstone_bricks",
            "/fill ~ ~-1 ~ ~ ~-1 ~ minecraft:sand replace minecraft:sandstone",
            "/fill ~ ~-1 ~ ~ ~-1 ~ minecraft:red_sand replace minecraft:red_sandstone",
            "/fill ~ ~-1 ~ ~ ~-1 ~ minecraft:cobbled_deepslate replace minecraft:deepslate",
            "/execute as @s at @s if block ~ ~-1 ~ melon_block run fill ~ ~-1 ~ ~ ~-1 ~ air destroy"
          ]
        }
      }
    }
  }
}
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                                               
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                                   
                                    
                                    
                                    
                                                               
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                                   
                                    
                                    
                                    
                                                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                                   
                                    
                                    
                                    
                                                               
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                                   
                                    
                                    
                                    
                                                                   
                                                                                  
                                                                                                                                           
                                                                    
                                    
                                    
                                    
                                                   
                                    
                                    
                                    
                                                                   
                                                                                  
                                                                                                                                           
                                                                                                                               
                                                                               
                                                                                  
                                                                                                                                           
                                                                    
                                    
                                    
                                    
                                                   
                                    
                                    
                                    
                                                                   
                                                                                  
                                                                                                                                           
                                                                                                                               
                                                                                     