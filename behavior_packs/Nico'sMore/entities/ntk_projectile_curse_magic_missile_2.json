{
  "format_version": "1.21.90",
  "minecraft:entity": {
    "description": {
      "identifier": "ntk:projectile_curse_magic_missile_2",
      "runtime_identifier": "minecraft:arrow",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "component:projectile_despawn": {
				"minecraft:instant_despawn": {
				  "remove_child_entities": false
				}
			}
    },
    "components": {
      "minecraft:collision_box": {
        "height": 0.7,
        "width": 0.7
      },
      "minecraft:fire_immune": {},
      "minecraft:scale": {
        "value": 0.7
      },
      "minecraft:type_family": {
        "family": [
          "curse_magic_missile",
          "magic_missile",
          "magical_scourge_2",
          "spirit_piercer",
          "projectile",
          "inanimate"
        ]
      },
      
      "minecraft:physics": {
	      "has_collision": true,
        "has_gravity": false
      },
      "minecraft:projectile": {
				"crit_particle_on_hurt": true,
				"homing": false,
				"is_dangerous": false,
				"knockback": true,
				"multiple_targets": false,
				"reflect_on_hurt": false,
				"shoot_target": true,
        "should_bounce": false,
        "anchor": 1.0,
        "angle_offset": 0.0,
        "power": 1.8,
        "gravity": 0.001,
        "inertia": 0.99,
        "liquid_inertia": 0.99,
        "on_fire_time": 0.0,
        "uncertainty_base": 0.0,
        "uncertainty_multiplier": 0.0,
        "offset": [ 0.0, -0.2, 0.0 ],
				//"particle": "ntk:curse_magic_missile_impact_particle",
        "shoot_sound": "mob.shulker.shoot",
				"hit_sound": "bullet.hit",
				"hit_ground_sound": "bullet.hit",
				"filters": {},
				"on_hit": {
          "impact_damage": {
            "damage": 9,
            "catch_fire": false,
            "destroy_on_hit": false,
            "knockback": true,
            "should_bounce": false,
            "semi_random_diff_damage": false
          },
          /*"particle_on_hit": {
            "particle_type": "ntk:curse_magic_missile_impact_particle",
            "num_particles": 25,
            "on_entity_hit": true,
            "on_other_hit": true
          }*/
          "stick_in_ground": {
						"shake_time": 0.01
					},
          //"remove_on_hit": {},
          "definition_event": {
						"affect_projectile": true,
						"affect_shooter": false,
						"affect_target": false,
						"affect_splash_area": false,
						"event_trigger": {
							"event": "event:on_hit",
							"target": "self",
							"filters": {}
						}
					}
        }
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true,
        "push_towards_closest_space": false
      },
      "minecraft:timer": {
        "looping": false,
        "randomInterval": true,
        "random_time_choices": [
          { "weight": 100, "value": 2.8 },
          { "weight": 100, "value": 2.8 }
        ],
        "time_down_event": {
          "event": "event:on_timer_down",
          "target": "self"
        }
      },
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_dropped_ticks": 7,
          "max_optimized_distance": 80.0,
          "use_motion_prediction_hints": true
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "queue_command": {
          "command": [
            "playsound ominous_item_spawner.spawn_item_begin @a[r=16] ~ ~ ~ 1.0 1.0 0.5"
          ]
        }
      },
      "event:on_hit": {
        "sequence": [
          {
            "queue_command": {
              "command": [
                "playsound step.powder_snow @a[r=12] ~ ~ ~ 1.0 1.3 0.5",
                "particle ntk:curse_magic_missile_2_impact_particle ~ ~ ~",
                "damage @e[r=3] 4 projectile entity @s"
              ]
            },
            "add": {
              "component_groups": [
                "component:projectile_despawn"
              ]
            }
          }
        ]
      },
		  "event:on_timer_down": {
				"sequence": [
          {
            "queue_command": {
              "command": [
                "playsound step.powder_snow @a[r=12] ~ ~ ~ 1.0 1.3 0.5",
                "particle ntk:curse_magic_missile_2_impact_particle ~ ~ ~",
                "damage @e[r=3] 4 projectile entity @s"
              ]
            },
            "add": {
              "component_groups": [
                "component:projectile_despawn"
              ]
            }
          }
        ]
			}
		}
  }
}
