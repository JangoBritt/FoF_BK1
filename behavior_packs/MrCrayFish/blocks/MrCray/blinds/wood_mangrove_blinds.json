{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "mr:wood_mangrove_blinds_mr",
			"menu_category": {
				"category": "construction",
				"group": "mr:woodenBlids"
			},
			"traits": {"minecraft:placement_direction": {"enabled_states": ["minecraft:cardinal_direction"]}},
			"states": {
				"mr:close": [ true, false ],
				"mr:top": [ false, true ]
			}
		},
		"permutations": [
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'north'","components": {"minecraft:transformation": {"rotation": [0,0,0]},"tag:mr:wood_mangrove_blinds_mr_north": {}}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'south'","components": {"minecraft:transformation": {"rotation": [0,180,0]},"tag:mr:wood_mangrove_blinds_mr_south": {}}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'west'","components": {"minecraft:transformation": {"rotation": [0,90,0]},"tag:mr:wood_mangrove_blinds_mr_west": {}}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'east'","components": {"minecraft:transformation": {"rotation": [0,270,0]},"tag:mr:wood_mangrove_blinds_mr_east": {}}}
		],
		"components": {
			"tag:minecraft:is_axe_item_destructible": {},
			"minecraft:geometry": {
				"identifier": "geometry.mr.blinds",
				"bone_visibility": {
					"top": "!q.block_state('mr:top')",
					"bot": "q.block_state('mr:top')",
					"close_bot": "q.block_state('mr:close')",
					"close_top": "q.block_state('mr:close') && q.block_state('mr:top')",
					"open_bot": "!q.block_state('mr:close')",
					"open_top": "!q.block_state('mr:close') && q.block_state('mr:top')"
				}
			},
