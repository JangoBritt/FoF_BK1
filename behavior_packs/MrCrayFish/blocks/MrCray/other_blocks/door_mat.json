			}] },
			"minecraft:collision_box": { "origin": [ -8, 0, -6 ], "size": [ 16, 1, 12 ] },
			"minecraft:selection_box": { "origin": [ -8, 0, -6 ], "size": [ 16, 1, 12 ] },
			"minecraft:light_dampening": 0,
			"minecraft:destructible_by_explosion": { "explosion_resistance": 0.0 },
