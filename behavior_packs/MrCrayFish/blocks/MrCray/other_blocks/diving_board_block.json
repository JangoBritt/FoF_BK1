{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "mr:diving_board_visual",
			"menu_category": {
				"category": "none",
				"is_hidden_in_commands": true
			},
			"traits": {
				"minecraft:placement_direction": { "enabled_states": ["minecraft:cardinal_direction"], "y_rotation_offset": 180 }
			},
			"states": {
				"mc:block_parts": [ 0, 1 ]
			}
		},
		"permutations": [
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'north'","components": {"minecraft:transformation": {"rotation": [ 0, 0, 0 ]}}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'south'","components": {"minecraft:transformation": {"rotation": [ 0, 180, 0 ]}}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'west'","components": {"minecraft:transformation": {"rotation": [ 0, 90, 0 ]}}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'east'","components": {"minecraft:transformation": {"rotation": [ 0, -90, 0 ]}}},
			{"condition": "q.block_state('mc:block_parts') == 0", "components": {
				"minecraft:placement_filter": {"conditions": [
					{
						"allowed_faces": ["north"],
						"block_filter": [{"name": "mr:diving_board_visual","states": {"minecraft:cardinal_direction": "north", "mc:block_parts": 1}}]
					},
					{
						"allowed_faces": ["south"],
						"block_filter": [{"name": "mr:diving_board_visual","states": {"minecraft:cardinal_direction": "south", "mc:block_parts": 1}}]
					},
					{
						"allowed_faces": ["west"],
						"block_filter": [{"name": "mr:diving_board_visual","states": {"minecraft:cardinal_direction": "west", "mc:block_parts": 1}}]
					},
					{
						"allowed_faces": ["east"],
						"block_filter": [{"name": "mr:diving_board_visual","states": {"minecraft:cardinal_direction": "east", "mc:block_parts": 1}}]
					}
				]}
			}},
			{"condition": "q.block_state('mc:block_parts') == 1", "components": {
				"minecraft:placement_filter": {"conditions": [
					{
						"allowed_faces": ["south"],
						"block_filter": [{"name": "mr:diving_board_visual","states": {"minecraft:cardinal_direction": "north", "mc:block_parts": 0}}]
					},
					{
						"allowed_faces": ["north"],
						"block_filter": [{"name": "mr:diving_board_visual","states": {"minecraft:cardinal_direction": "south", "mc:block_parts": 0}}]
					},
					{
						"allowed_faces": ["east"],
						"block_filter": [{"name": "mr:diving_board_visual","states": {"minecraft:cardinal_direction": "west", "mc:block_parts": 0}}]
					},
					{
						"allowed_faces": ["west"],
						"block_filter": [{"name": "mr:diving_board_visual","states": {"minecraft:cardinal_direction": "east", "mc:block_parts": 0}}]
					}
				]}
			}}
		],
		"components": {
			"tag:minecraft:is_pickaxe_item_destructible": {},
			"minecraft:geometry": {
				"identifier": "geometry.mr.diving_board",
				"bone_visibility": {
					"part_0": "q.block_state('mc:block_parts') == 0",
					"part_1": "q.block_state('mc:block_parts') == 1"
				}
			},
			"minecraft:loot": "loot_tables/empty.json",
			"minecraft:display_name": "mc.unobtainable_block.name",
			"minecraft:material_instances": {
				"*": {"texture": "mr:concrete_white","render_method": "opaque"},
				"concrete": {"texture": "mr:concrete_light_gray","render_method": "opaque"}
			},
			"minecraft:collision_box": { "origin": [ -8, 0, -8 ], "size": [ 16, 6, 16 ] },
			"minecraft:selection_box": { "origin": [ -8, 0, -8 ], "size": [ 16, 6, 16 ] },
			"minecraft:light_dampening": 0,
			"minecraft:liquid_detection": {
				"detection_rules": [
					{
						"can_contain_liquid": true,
						"liquid_type": "water",
						"on_liquid_touches": "no_reaction"
					}
				]
			},
			"minecraft:redstone_conductivity": {
				"allows_wire_to_step_down": false,
				"redstone_conductor": false
			},
			"minecraft:destructible_by_explosion": { "explosion_resistance": 6.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 2.0 },
			"minecraft:custom_components": [ "mr:break_large_block", "mr:bounce_board", "mr:place_1x1x2_parts" ],
			"minecraft:map_color": "#ced4d5"
		}
	}
}