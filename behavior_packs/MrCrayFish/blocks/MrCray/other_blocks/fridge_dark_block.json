{
	"format_version": "1.21.60",
	"minecraft:block": {
		"description": {
			"identifier": "mr:fridge_dark_visual",
			"menu_category": {
				"category": "none",
				"is_hidden_in_commands": true
			},
			"traits": {
				"minecraft:placement_direction": {"enabled_states": ["minecraft:cardinal_direction"]}
			},
			"states": {
				"mr:close": [ true, false ],
				"mc:block_parts": [ 0, 1 ]
			}
		},
		"permutations": [
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'north'","components": {"minecraft:transformation": {"rotation": [ 0, 0, 0 ]}}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'south'","components": {"minecraft:transformation": {"rotation": [ 0, 180, 0 ]}}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'west'","components": {"minecraft:transformation": {"rotation": [ 0, 90, 0 ]}}},
			{"condition": "q.block_state('minecraft:cardinal_direction') == 'east'","components": {"minecraft:transformation": {"rotation": [ 0, -90, 0 ]}}},
			{"condition": "q.block_state('mc:block_parts') == 0", "components": {
				"minecraft:placement_filter": {"conditions": [
					{
						"allowed_faces": ["down"],
						"block_filter": [{"name": "mr:fridge_dark_visual","states": { "mc:block_parts": 1 }}]
					}
				]}
			}},
			{"condition": "q.block_state('mc:block_parts') == 1", "components": {
				"minecraft:placement_filter": {"conditions": [
					{
						"allowed_faces": ["up"],
						"block_filter": [{"name": "mr:fridge_dark_visual","states": { "mc:block_parts": 0 }}]
					}
				]}
			}}
		],
		"components": {
			"tag:minecraft:is_pickaxe_item_destructible": {},
			"minecraft:geometry": {
				"identifier": "geometry.mr.fridge",
				"bone_visibility": {
					"bottom": "q.block_state('mc:block_parts') == 0",
					"top": "q.block_state('mc:block_parts') == 1",
					"open_b": "!q.block_state('mr:close') && q.block_state('mc:block_parts') == 0",
					"close_b": "q.block_state('mr:close') && q.block_state('mc:block_parts') == 0",
					"open_t": "!q.block_state('mr:close') && q.block_state('mc:block_parts') == 1",
					"close_t": "q.block_state('mr:close') && q.block_state('mc:block_parts') == 1"
				}
			},
			"minecraft:loot": "loot_tables/empty.json",
			"minecraft:display_name": "mc.unobtainable_block.name",
			"minecraft:material_instances": {
				"*": {"texture": "mr:concrete_gray","render_method": "opaque"},
				"concrete": {"texture": "mr:concrete_black","render_method": "opaque"}
			},
			"minecraft:collision_box": true,
			"minecraft:selection_box": true,
			"minecraft:light_dampening": 0,
			"minecraft:liquid_detection": { "detection_rules": [ {
				"can_contain_liquid": true,
				"liquid_type": "water",
				"on_liquid_touches": "blocking",
				"stops_liquid_flowing_from_direction": [ "north", "west", "south", "east", "down", "up" ]
			} ] },
			"minecraft:redstone_conductivity": {
				"allows_wire_to_step_down": false,
				"redstone_conductor": false
			},
			"minecraft:destructible_by_explosion": { "explosion_resistance": 6.0 },
			"minecraft:destructible_by_mining": { "seconds_to_destroy": 2.0 },
			"minecraft:custom_components": [ "mr:break_large_block", "mr:fridge", "mr:place_1x2x1_parts" ],
			"minecraft:map_color": "#36393d"
		}
	}
}