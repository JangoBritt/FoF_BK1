					"w": "q.block_state('mr:w') == 0",
					"nw": "q.block_state('mr:n') == 0 || q.block_state('mr:w') == 0",
					"ne": "q.block_state('mr:n') == 0 || q.block_state('mr:e') == 0",
					"sw": "q.block_state('mr:s') == 0 || q.block_state('mr:w') == 0",
