{
	"format_version": "1.21.60",
	"minecraft:entity": {
		"description": {
			"identifier": "mr:post_box",
			"is_summonable": true,
			"is_spawnable": false,
			"is_experimental": false
		},
		"component_groups": {
			"mr:no_particle": {
				"minecraft:transformation": {
					"delay": 0,
					"into": "mr:no_sound_mr"
				}
			}
		},
		"components": {
			"minecraft:type_family": {
				"family": [ "chest", "inanimate", "mr:mailbox" ]
		  	},
			"minecraft:collision_box": {
				"width": 0.9,
				"height": 0.2
			},
			"minecraft:item_hopper": {},
			"minecraft:inventory": {
				"can_be_siphoned_from": false,
				"container_type": "inventory",
				"inventory_size": 9,
				"restrict_to_owner": false
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:physics": {
				"has_collision": false,
				"has_gravity": false
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "all",
						"deals_damage": "no"
					}
				]
			},
			"minecraft:health": {
				"value": 1,
				"max": 1
			},
			"minecraft:nameable": {
				"allow_name_tag_renaming": false,
				"always_show": false
			},
			"minecraft:on_death": {
				"event": "mr:no_particle",
				"target": "self"
			},
			"minecraft:inside_block_notifier": {
				"block_list": [
					{
						"block": {
							"name": "minecraft:air"
						},
						"entered_block_event": {
							"event": "mr:despawn",
							"target": "self"
						}
					}
				]
			}
		},
		"events": {
			"mr:despawn": {
				"queue_command": { "command": [ "kill @s" ] }
			},
			"mr:no_particle": {
				"add": {
					"component_groups": [
						"mr:no_particle"
					]
				}
			}
		}
	}
}