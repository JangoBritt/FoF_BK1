{
	"format_version": "1.21.60",
	"minecraft:entity": {
		"description": {
			"identifier": "mr:food",
			"is_summonable": true,
			"is_spawnable": false,
			"is_experimental": false,
			"properties": {
				"mr:flipped": {
					"type": "bool",
					"default": false,
					"client_sync": true
				},
				"mr:cooked": {
					"type": "bool",
					"default": false,
					"client_sync": true
				}
			},
			"runtime_identifier": "minecraft:fox"
		},
		"component_groups": {
			"mr:despawn": { "minecraft:instant_despawn": {} },
			"mr:flip": {
				"minecraft:timer": {
					"looping": false,
					"time": 10,
					"time_down_event": { "event": "mr:final_cooked" }
				}
			}
		},
		"components": {
			"minecraft:type_family":{
				"family":[ "inanimate", "block"]
			},
			"minecraft:nameable": {
				"allow_name_tag_renaming": false,
				"always_show": false
			},
			"minecraft:shareables": {
				"all_items": true,
				"singular_pickup": true,
				"all_items_max_amount": 1,
				"items": [
					{ "item": "minecraft:beef", "priority": 0, "max_amount": 1 }
				]
			},
			"minecraft:equip_item": {},
			"minecraft:behavior.equip_item": { "priority": 2 },
			"minecraft:scale": {
				"value": 0.6
			},
			"minecraft:interact": {
				"interactions": [
					{
						"on_interact": {
							"filters": [
								{
									"all_of": [
										{"subject": "other","test": "has_equipment","domain": "hand","operator": "==","value": "mr:spatula_mr"},
										{"test": "bool_property", "subject": "self", "domain": "mr:flipped", "operator": "equals", "value": false },
										{"test": "bool_property", "subject": "self", "domain": "mr:cooked", "operator": "equals", "value": true }
									]
								}
							],
							"event": "mr:flip"
						},
						"hurt_item": 1,
						"interact_text":"action.interact.flip_food"
					},
					{
						"on_interact": {
							"filters": [
								{
									"all_of": [
										{"test": "bool_property", "subject": "self", "domain": "mr:flipped", "operator": "equals", "value": true },
										{"test": "bool_property", "subject": "self", "domain": "mr:cooked", "operator": "equals", "value": true }
									]
								}
							],
							"event": "mr:remove_food"
						},
						"interact_text":"action.interact.remove_food"
					}
				]
			},
			"minecraft:timer": {
				"looping": false,
				"time": 10,
				"time_down_event": { "event": "mr:cooked" }
	  		},
			"minecraft:collision_box": {
				"width": 0,
				"height": 0
			},
			"minecraft:custom_hit_test": {
				"hitboxes": [
					{
						"width": 0.2,
						"height": 0.1,
						"pivot": [ 0, 0.05, 0 ]
					}
				]
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:physics": {
				"has_collision": false,
				"has_gravity": false
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "all",
						"deals_damage": "no"
					}
				]
			},
			"minecraft:health": {
				"value": 1,
				"max": 1
			},
			"minecraft:inside_block_notifier": {
				"block_list": [
					{
						"block": {
							"name": "minecraft:air"
						},
						"entered_block_event": {
							"event": "mr:despawn",
							"target": "self"
						}
					}
				]
			},
			"minecraft:mob_effect_immunity": {
				"mob_effects": [
					"invisibility"
				]
			},
			"minecraft:fire_immune": {},
			"minecraft:persistent": {},
			"minecraft:body_rotation_blocked": {}
		},
		"events": {
			"mr:despawn": {},
			"mr:flip": {
				"queue_command": {
					"command": [ "playanimation @s animation.mr.food.flip" ]
				},
				"set_property": {
					"mr:flipped": true,
					"mr:cooked": false
				},
				"add": {
					"component_groups": [ "mr:flip" ]
				}
			},
			"mr:cooked": {
				"set_property": {
					"mr:cooked": true
				}
			},
			"mr:final_cooked": {
				"set_property": {
					"mr:cooked": true
				}
			},
			"mr:remove_food": {}
		}
	}
}