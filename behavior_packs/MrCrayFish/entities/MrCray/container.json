				"is_pushable_by_piston": false
			},
			"minecraft:physics": {
				"has_collision": false,
				"has_gravity": false
			},
			"minecraft:tameable": {
				"probability": 0.001,
				"tame_items": "bedrock",
				"tame_event": {
					"event": "minecraft:on_tame",
					"target": "self"
				}
			},
			"minecraft:damage_sensor": {
