						"requires": "($new_container_title = 'MrCrayFish.desk_cabinet') and $pocket_screen",
						"$use_custom_pocket_toast": true,
						"$screen_content": "pocket_containers.desk_cabinet",
						"$container_size": 9
					}
				]
			},
			{
				"array_name": "variables",
				"operation": "insert_back",
				"value": [
					{
						"requires": "(('%.19s' * $new_container_title) = 'MrCrayFish.mail_box') and $desktop_screen",
						"$root_panel": "mcf_container.mail_box",
						"$screen_content": "mcf_container.mail_box",
						"$container_size": 9
					},
					{
						"requires": "(('%.19s' * $new_container_title) = 'MrCrayFish.mail_box') and $pocket_screen",
						"$use_custom_pocket_toast": true,
						"$screen_content": "pocket_containers.mail_box",
						"$container_size": 9
					}
				]
			},
			{
				"array_name": "variables",
				"operation": "insert_back",
				"value": [
					{
						"requires": "($new_container_title = 'MrCrayFish.cabinet') and $desktop_screen",
						"$root_panel": "mcf_container.cabinet",
						"$screen_content": "mcf_container.cabinet",
						"$container_size": 18
					},
					{
						"requires": "($new_container_title = 'MrCrayFish.cabinet') and $pocket_screen",
						"$use_custom_pocket_toast": true,
						"$screen_content": "pocket_containers.cabinet",
						"$container_size": 18
					}
				]
			},
			{
				"array_name": "variables",
				"operation": "insert_back",
				"value": [
					{
						"requires": "($new_container_title = 'MrCrayFish.crate') and $desktop_screen",
