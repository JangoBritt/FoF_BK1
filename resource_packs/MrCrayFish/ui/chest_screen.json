						"$container_size": 27
					}
				]
			},
			{
				"array_name": "variables",
				"operation": "insert_back",
				"value": [
					{
						"requires": "($new_container_title = 'MrCrayFish.fridge') and $desktop_screen",
						"$root_panel": "chest.inventory_54_root_panel",
						"$screen_content": "chest.inventory_54_root_panel",
						
						"$container_size": 54
					},
					{
						"requires": "($new_container_title = 'MrCrayFish.fridge') and $pocket_screen",
						"$use_custom_pocket_toast": true,
						"$screen_content": "chest.inventory_54_root_panel",
						"$container_size": 54
					}
				]
			},
			{
				"array_name": "variables",
				"operation": "insert_back",
				"value": [
					{
						"requires": "($new_container_title = 'MrCrayFish.freezer')",
						"$root_panel": "freezer_ui.freezer_ui_panel",
						"$screen_content": "freezer_ui.freezer_ui_panel",
						"$container_size": 5
					}
				]
			},
			{
				"array_name": "variables",
				"operation": "insert_back",
				"value": [
					{
						"requires": "($new_container_title = 'MrCrayFish.post_box') and $desktop_screen",
						"$root_panel": "mcf_container.post_box",
						"$screen_content": "mcf_container.post_box",
						"$container_size": 9
					},
					{
						"requires": "($new_container_title = 'MrCrayFish.post_box') and $pocket_screen",
						"$use_custom_pocket_toast": true,
						"$screen_content": "pocket_containers.post_box",
						"$container_size": 9
					}
				]
			}
		]
