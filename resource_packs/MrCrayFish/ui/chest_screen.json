	//--------------------------------------------------------------------------//
	"custom_container_grid@common.container_grid": {
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"layer": 3,
		"grid_item_template": "@common.container_item",
		"collection_name": "container_items",
		"$item_collection_name": "container_items"
	},
	
	//--------------------------------------------------------------------------//
	"small_chest_grid": {
		"type": "grid",
		"size": [
			162,
			54
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"grid_dimensions": [
			9,
			3
		],
		"grid_item_template": "chest.chest_grid_item",
		"collection_name": "container_items"
	},
	"small_chest_panel_top_half": {
		"type": "panel",
		"size": [
			"100%",
			"50%"
		],
		"offset": [
			0,
			12
		],
		"anchor_to": "top_left",
		"anchor_from": "top_left",
		"controls": [
			{
				"chest_label@chest.chest_label": {}
			},
			{
				"small_chest_grid@chest.small_chest_grid": {
					"offset": [
						7,
						9
					]
				}
			}
		]
	},
	"small_root_panel@common.root_panel": {
		"$chest_panel|default": "chest.small_chest_panel_top_half",
		"$backg|default": "$backg",
		"layer": 1,
		"controls": [
			{
				"common_panel@common.common_panel": {
					"$dialog_background": "$backg"
				}
			},
			{
				"chest_panel": {
					"type": "panel",
					"layer": 5,
					"controls": [
						{
							"small_chest_panel_top_half@$chest_panel": {}
						},
						{
							"inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
						},
						{
							"hotbar_grid@common.hotbar_grid_template": {}
						},
						{
							"inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
						}
					]
				}
			},
			{
				"inventory_selected_icon_button@common.inventory_selected_icon_button": {}
			},
			{
				"gamepad_cursor@common.gamepad_cursor_button": {}
			}
		]
	},
	"small_chest_panel": {
		"type": "panel",
		"controls": [
			{
				"container_gamepad_helpers@common.container_gamepad_helpers": {}
			},
			{
				"flying_item_renderer@common.flying_item_renderer": {
					"layer": 11
				}
			},
			{
				"selected_item_details_factory@common.selected_item_details_factory": {
					"control_name": "@chest.selected_item_details"
				}
			},
			{
				"item_lock_notification_factory@common.item_lock_notification_factory": {
					"control_name": "@common.item_lock_notification"
				}
			},
			{
				"root_panel@$root_panel": {}
			}
		]
	},
	"ender_chest_panel@chest.small_chest_panel": {},
	"small_chest_screen@common.inventory_screen_common": {
		"$close_on_player_hurt|default": true,
		"close_on_player_hurt": "$close_on_player_hurt",
		"$root_panel|default": "chest.small_root_panel",
		"$backg|default": "common.dialog_background_opaque",
		"$new_container_title|default": "$container_title",
		"$container_size|default": 27,
		"modifications": [
			{
				"array_name": "variables",
				"operation": "insert_back",
				"value": [
					{
						"requires": "($new_container_title = 'MrCrayFish.bedside_cabinet') and $desktop_screen",
						"$root_panel": "mcf_container.bedside_cabinet",
						"$screen_content": "mcf_container.bedside_cabinet",
						"$container_size": 9
					},
					{
						"requires": "($new_container_title = 'MrCrayFish.bedside_cabinet') and $pocket_screen",
						"$use_custom_pocket_toast": true,
						"$screen_content": "pocket_containers.bedside_cabinet",
						"$container_size": 9
					}
				]
			},
			{
				"array_name": "variables",
				"operation": "insert_back",
				"value": [
					{
						"requires": "($new_container_title = 'MrCrayFish.drawer') and $desktop_screen",
						"$root_panel": "mcf_container.kitchen_drawer",
						"$screen_content": "mcf_container.kitchen_drawer",
						"$container_size": 9
					},
					{
						"requires": "($new_container_title = 'MrCrayFish.drawer') and $pocket_screen",
						"$use_custom_pocket_toast": true,
						"$screen_content": "pocket_containers.drawer",
						"$container_size": 9
					}
				]
			},
			{
				"array_name": "variables",
				"operation": "insert_back",
				"value": [
					{
						"requires": "($new_container_title = 'MrCrayFish.cooler') and $desktop_screen",
						"$root_panel": "mcf_container.cooler",
						"$screen_content": "mcf_container.cooler",
						"$container_size": 9
					},
					{
						"requires": "($new_container_title = 'MrCrayFish.cooler') and $pocket_screen",
						"$use_custom_pocket_toast": true,
						"$screen_content": "pocket_containers.cooler",
						"$container_size": 9
					}
				]
			},
			{
				"array_name": "variables",
				"operation": "insert_back",
