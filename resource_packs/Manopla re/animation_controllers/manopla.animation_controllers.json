{
  "format_version": "1.10.0",
  "animation_controllers" : {
    "controller.animation.manopla_controller" : {
      "initial_state": "default",
      "states" : {
        "default" : {
          "blend_transition": 0.1,
          "transitions" : [
            { "manopla_attack": "q.get_equipped_item_name == 'manopla' && v.attack_time" }
          ]
        },
        "manopla_attack" : {
          "animations" : [
            "manopla.timer",
            "manopla.attack1"
          ],
          "blend_transition": 0.1,
          "transitions" : [
            {"default": "q.all_animations_finished || q.get_equipped_item_name != 'manopla'"},
            {"manopla_attack2": "q.any_animation_finished && variable.attack_time"}
          ]
        },
        "manopla_attack2" : {
          "animations" : [
            "manopla.timer",
            "manopla.attack2"
          ],
          "blend_transition": 0.1,
          "transitions" : [
            {"default": "q.all_animations_finished || q.get_equipped_item_name != 'manopla'"},
            {"manopla_attack3": "q.any_animation_finished && variable.attack_time"}
          ]
        },
        "manopla_attack3" : {
          "animations" : [
            "manopla.timer",
            "manopla.attack3"
          ],
          "blend_transition": 0.1,
          "transitions" : [
            {"default": "q.all_animations_finished || q.get_equipped_item_name != 'manopla'"},
            {"manopla_attack": "q.any_animation_finished && variable.attack_time"}
          ]
        }
      }
    }
  }
}
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                    
                                                 