{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "medieval:light",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/medieval/particles/light"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true,
				"velocity": true
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 3,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.6,2)"
			},
			"minecraft:particle_initial_spin": {
				"rotation_rate": 90
			},
			"minecraft:particle_initial_speed": 180,
			"minecraft:particle_motion_parametric": {
				"rotation": 90
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.4+variable.particle_random_1*0.4)-(0.1*variable.particle_age)", "(0.4+variable.particle_random_1*0.4)-(0.1*variable.particle_age)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 64,
					"texture_height": 64,
					"uv": [0, 0],
					"uv_size": [64, 64]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#82FFD400",
						"1.0": "#00FFDB52"
					}
				}
			}
		}
	}
}