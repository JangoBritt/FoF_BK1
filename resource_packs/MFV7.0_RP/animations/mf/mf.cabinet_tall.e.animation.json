				}
			}
		},
		"animation.mf.cabinet_tall.e.close": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.25,
			"bones": {
				"door_normal": {
					"rotation": {
						"0.0": [0, 90, 0],
						"0.25": [0, 0, 0]
					}
				},
				"door_side": {
					"rotation": {
						"0.0": [0, -90, 0],
