				"wood_acacia": "textures/blocks/log_acacia",
				"stripped_acacia": "textures/blocks/stripped_acacia_log",
				"wood_dark_oak": "textures/blocks/log_big_oak",
				"stripped_dark_oak": "textures/blocks/stripped_dark_oak_log",
				"wood_mangrove": "textures/blocks/mangrove_log_side",
