{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "medieval:weapon_right",
			"enable_attachables": true,
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/empty"
			},
			"geometry": {
				"default": "geometry.mf.weapon_right"
			},
            "animations": {
                "shield_main": "animation.mf.weapon_main.shield",
                "bow_main": "animation.mf.weapon_main.bow",
                "crossbow_main": "animation.mf.weapon_main.crossbow",
                "trident_main": "animation.mf.weapon_main.trident"
            },
            "scripts": {
                "animate": [
                    { "shield_main": "q.is_item_name_any('slot.weapon.mainhand', 0, 'minecraft:shield')" },
                    { "bow_main": "q.is_item_name_any('slot.weapon.mainhand', 0, 'minecraft:bow')" },
                    { "crossbow_main": "q.is_item_name_any('slot.weapon.mainhand', 0, 'minecraft:crossbow')" },
                    { "trident_main": "q.is_item_name_any('slot.weapon.mainhand', 0, 'minecraft:trident')" }
                ]
            },
			"render_controllers": [ "controller.render.default" ]
		}
	}
}